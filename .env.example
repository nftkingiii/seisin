# Copy to .env (untracked). Never put a seed phrase or spending key here.
# Public anchor account: a dedicated wallet used only for Seisin.
ANCHOR_ADDRESS=u1...
ANCHOR_UIVK=uivk1...   # or a full viewing key (uview1...) if the wallet only exports that
# Optional
# ANCHOR_ZATS=10000
# COLLECTION=deeds
# SUPPLY=32
# DEMO_ISSUANCE=on
# OPERATOR_TOKEN=   # production only; locally one is created in data/
